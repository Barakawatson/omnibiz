!assets/uploads/profile_admin/.gitkeep
assets/uploads/po_invoices/*
!assets/uploads/po_invoices/.gitkeep
assets/uploads/shop_logo/*
!assets/uploads/shop_logo/.gitkeep

# OS cruft
Thumbs.db
.DS_Store

# Screenshots capture live-install data (real names, stale branding) -
